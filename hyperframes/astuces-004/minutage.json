	"phrases": [
		{
			"texte": "Ton téléphone affiche trente pour cent, puis il s'éteint d'un coup.",
			"emotion": "curieux",
			"pose": "reflechit",
			"start": 0,
			"end": 3.13
		},
		{
			"texte": "Il fait froid, et ce n'est pas un hasard.",
			"emotion": null,
			"pose": "reflechit",
			"start": 3.69,
			"end": 5.49
		},
		{
			"texte": "Dans une batterie au lithium, de petites particules chargées se déplacent d'un côté à l'autre pour produire du courant.",
			"emotion": null,
			"pose": "reflechit",
			"start": 6.05,
			"end": 11.09
		},
		{
			"texte": "Quand il fait froid, tout ralentit.",
			"emotion": null,
			"pose": "reflechit",
			"start": 11.65,
			"end": 13.24
		},
		{
			"texte": "C'est comme toi le matin, avant le café.",
			"emotion": "amusé",
			"pose": "rit",
			"start": 13.59,
			"end": 15.38
		},
		{
			"texte": "Résultat : la batterie fournit moins de courant, et le téléphone croit qu'elle est vide alors qu'il reste de l'énergie.",
			"emotion": null,
			"pose": "rit",
			"start": 15.92,
			"end": 21.09
		},
		{
			"texte": "Dès qu'elle se réchauffe, elle revient.",
			"emotion": null,
			"pose": "rit",
			"start": 21.63,
			"end": 23.12
		},
		{
			"texte": "Trois gestes : garde ton téléphone dans une poche intérieure.",
			"emotion": null,
			"pose": "rit",
			"start": 23.66,
			"end": 26.72
		},
		{
			"texte": "Ne le charge pas quand il est glacé.",
			"emotion": null,
			"pose": "rit",
			"start": 27.28,
			"end": 28.83
		},
		{
			"texte": "Et réchauffe-le doucement avant de t'en servir.",
			"emotion": null,
			"pose": "rit",
			"start": 29.4,
			"end": 31.5
		},
		{
			"texte": "Demain : pourquoi un mot de passe long bat un mot de passe compliqué.",
			"emotion": "souriant",
			"pose": "content",
			"start": 32.06,
			"end": 35.64
		},
		{
			"texte": "Il s'éteint à combien, chez toi ?",
			"emotion": null,
			"pose": "content",
			"start": 36.18,
			"end": 37.43
		}
	],
