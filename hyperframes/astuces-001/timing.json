	"sentences": [
		{
			"text": "Tu charges ton téléphone dans ton lit ?",
			"emotion": "faussement solennel",
			"pose": "choque",
			"start": 0.36,
			"end": 1.59
		},
		{
			"text": "Arrête.",
			"emotion": "sec",
			"pose": "choque",
			"start": 2.19,
			"end": 3.13
		},
		{
			"text": "Ton téléphone n'est pas un chat : il n'a pas besoin de dormir sous la couette.",
			"emotion": "amusé",
			"pose": "rit",
			"start": 3.75,
			"end": 7.02
		},
		{
			"text": "Tu sais ce qui se passe quand il charge ?",
			"emotion": "curieux, plus bas",
			"pose": "reflechit",
			"start": 8.39,
			"end": 9.6
		},
		{
			"text": "Le courant ne va pas tout entier dans la batterie.",
			"emotion": "pédagogue",
			"pose": "explique",
			"start": 10.78,
			"end": 12.8
		},
		{
			"text": "Une partie se perd dans le câble, dans le chargeur, et dans la batterie elle-même.",
			"emotion": null,
			"pose": "explique",
			"start": 13.48,
			"end": 17
		},
		{
			"text": "Cette partie perdue devient de la chaleur.",
			"emotion": null,
			"pose": "explique",
			"start": 17.87,
			"end": 19.85
		},
		{
			"text": "En gros, ton chargeur fait des heures sup, et il transpire.",
			"emotion": "riant",
			"pose": "rit",
			"start": 20.6,
			"end": 23.44
		},
		{
			"text": "Sur une table, la chaleur s'échappe dans l'air.",
			"emotion": "posé",
			"pose": "explique",
			"start": 24.41,
			"end": 26.32
		},
		{
			"text": "Sous la couette, elle reste coincée.",
			"emotion": "taquin",
			"pose": "content",
			"start": 26.9,
			"end": 28.36
		},
		{
			"text": "Ton téléphone fait un sauna, sans l'avoir demandé !",
			"emotion": "faussement choqué",
			"pose": "choque",
			"start": 29.25,
			"end": 31.75
		},
		{
			"text": "Et la chaleur, c'est l'ennemie des batteries au lithium : plus elles chauffent souvent, plus elles perdent de la capacité.",
			"emotion": "sérieux",
			"pose": "explique",
			"start": 32.62,
			"end": 37.68
		},
		{
			"text": "Alors, trois gestes.",
			"emotion": "énergique, il compte",
			"pose": "explique",
			"start": 38.69,
			"end": 39.81
		},
		{
			"text": "Une : une surface dure, à l'air libre.",
			"emotion": null,
			"pose": "explique",
			"start": 40.34,
			"end": 42.66
		},
		{
			"text": "Deux : la coque enlevée s'il chauffe.",
			"emotion": null,
			"pose": "explique",
			"start": 43.2,
			"end": 45.16
		},
		{
			"text": "Trois : pas de jeu pendant la charge.",
			"emotion": null,
			"pose": "explique",
			"start": 45.71,
			"end": 47.24
		},
		{
			"text": "Oui, même pas un petit match !",
			"emotion": "indigné, puis rire",
			"pose": "choque",
			"start": 47.89,
			"end": 49.14
		},
		{
			"text": "On ne fait pas courir un marathon à quelqu'un qui est en train de manger.",
			"emotion": "rire",
			"pose": "rit",
			"start": 49.54,
			"end": 51.59
		},
		{
			"text": "Et toi, tu charges où ?",
			"emotion": "souriant, face caméra",
			"pose": "content",
			"start": 52.11,
			"end": 54.16
		},
		{
			"text": "Dis-le en commentaire.",
			"emotion": null,
			"pose": "content",
			"start": 54.64,
			"end": 55.2
		}
	],
