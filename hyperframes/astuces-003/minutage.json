	"phrases": [
		{
			"texte": "Pourquoi ton wifi rame dans la chambre, mais pas dans le salon ?",
			"emotion": "curieux",
			"pose": "reflechit",
			"start": 0,
			"end": 3.02
		},
		{
			"texte": "Le wifi, ce sont des ondes radio.",
			"emotion": null,
			"pose": "reflechit",
			"start": 3.52,
			"end": 5.29
		},
		{
			"texte": "Ta box les envoie comme une ampoule envoie de la lumière, et elles s'affaiblissent à chaque mur.",
			"emotion": null,
			"pose": "reflechit",
			"start": 5.79,
			"end": 9.63
		},
		{
			"texte": "Ton mur en béton, c'est un videur : il laisse passer très peu de monde.",
			"emotion": "amusé",
			"pose": "rit",
			"start": 10.09,
			"end": 13.78
		},
		{
			"texte": "Il y a deux fréquences.",
			"emotion": null,
			"pose": "rit",
			"start": 14.32,
			"end": 15.33
		},
		{
			"texte": "La 2,4 gigahertz va plus loin, mais plus lentement.",
			"emotion": null,
			"pose": "rit",
			"start": 15.73,
			"end": 18.82
		},
		{
			"texte": "La 5 gigahertz est plus rapide, mais elle s'essouffle vite.",
			"emotion": null,
			"pose": "rit",
			"start": 19.34,
			"end": 22.33
		},
		{
			"texte": "Elle sprinte, mais elle ne fait pas le marathon.",
			"emotion": null,
			"pose": "rit",
			"start": 22.76,
			"end": 24.65
		},
		{
			"texte": "Et ton micro-ondes utilise une fréquence proche de la 2,4 : il peut la perturber.",
			"emotion": null,
			"pose": "rit",
			"start": 25.22,
			"end": 29.5
		},
		{
			"texte": "Trois gestes : place ta box au centre et en hauteur, loin des murs épais et du micro-ondes.",
			"emotion": null,
			"pose": "rit",
			"start": 30.01,
			"end": 34.91
		},
		{
			"texte": "Près de la box, choisis la 5.",
			"emotion": null,
			"pose": "rit",
			"start": 35.45,
			"end": 37
		},
		{
			"texte": "Loin, choisis la 2,4.",
			"emotion": null,
			"pose": "rit",
			"start": 37.56,
			"end": 39.38
		},
		{
			"texte": "Demain : pourquoi ton téléphone s'éteint quand il fait froid.",
			"emotion": "souriant",
			"pose": "content",
			"start": 39.91,
			"end": 42.88
		},
		{
			"texte": "Ta box est cachée où ?",
			"emotion": null,
			"pose": "content",
			"start": 43.42,
			"end": 44.4
		}
	],
