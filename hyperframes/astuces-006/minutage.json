	"phrases": [
		{
			"texte": "Ton téléviseur est éteint.",
			"emotion": "curieux",
			"pose": "reflechit",
			"start": 0,
			"end": 1.28
		},
		{
			"texte": "Mais il consomme encore.",
			"emotion": null,
			"pose": "reflechit",
			"start": 1.71,
			"end": 2.66
		},
		{
			"texte": "Comment ?",
			"emotion": null,
			"pose": "reflechit",
			"start": 2.99,
			"end": 3.26
		},
		{
			"texte": "Éteint, il n'est pas vraiment éteint : il reste en veille.",
			"emotion": null,
			"pose": "reflechit",
			"start": 3.82,
			"end": 6.77
		},
		{
			"texte": "Un petit circuit attend ta télécommande, garde l'horloge et cherche parfois des mises à jour.",
			"emotion": null,
			"pose": "reflechit",
			"start": 7.27,
			"end": 11.45
		},
		{
			"texte": "Il fait semblant de dormir, mais il écoute.",
			"emotion": "amusé",
			"pose": "rit",
			"start": 11.84,
			"end": 14
		},
		{
			"texte": "Un appareil en veille consomme peu, mais ils sont nombreux : télé, box, console, chargeurs.",
			"emotion": null,
			"pose": "rit",
			"start": 14.53,
			"end": 19.76
		},
		{
			"texte": "Ensemble, ils tournent vingt-quatre heures sur vingt-quatre, toute l'année.",
			"emotion": null,
			"pose": "rit",
			"start": 20.3,
			"end": 23.25
		},
		{
			"texte": "Trois gestes : une multiprise à interrupteur pour le coin télé, que tu coupes le soir.",
			"emotion": null,
			"pose": "rit",
			"start": 23.79,
			"end": 27.92
		},
		{
			"texte": "Débranche les chargeurs inutilisés.",
			"emotion": null,
			"pose": "rit",
			"start": 28.37,
			"end": 29.91
		},
		{
			"texte": "Et regarde la petite lumière : si elle est allumée, l'appareil veille.",
			"emotion": null,
			"pose": "rit",
			"start": 30.33,
			"end": 33.66
		},
		{
			"texte": "Demain, on entre dans ton téléphone : pourquoi il rame quand il est plein.",
			"emotion": "souriant",
			"pose": "content",
			"start": 34.16,
			"end": 37.74
		},
		{
			"texte": "Combien de petites lumières dans ta chambre ?",
			"emotion": null,
			"pose": "content",
			"start": 38.13,
			"end": 39.67
		}
	],
