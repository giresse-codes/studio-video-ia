	"phrases": [
		{
			"texte": "Il est dix-sept heures douze.",
			"emotion": "calme, tendu",
			"pose": "neutre",
			"start": 0,
			"end": 1.27
		},
		{
			"texte": "Ta voiture quitte la route et tombe dans un canal.",
			"emotion": null,
			"pose": "neutre",
			"start": 1.79,
			"end": 3.92
		},
		{
			"texte": "Tu as environ une minute.",
			"emotion": null,
			"pose": "neutre",
			"start": 4.45,
			"end": 5.58
		},
		{
			"texte": "Pendant que la voiture flotte, l'eau pousse sur les portes.",
			"emotion": null,
			"pose": "neutre",
			"start": 6.08,
			"end": 8.68
		},
		{
			"texte": "Bientôt, tu ne pourras plus les ouvrir.",
			"emotion": null,
			"pose": "neutre",
			"start": 9.17,
			"end": 10.93
		},
		{
			"texte": "Alors oublie les portes.",
			"emotion": null,
			"pose": "neutre",
			"start": 11.5,
			"end": 12.53
		},
		{
			"texte": "Et n'appelle pas les secours tout de suite : chaque seconde compte.",
			"emotion": null,
			"pose": "neutre",
			"start": 12.94,
			"end": 15.72
		},
		{
			"texte": "Règle un : détache ta ceinture.",
			"emotion": null,
			"pose": "neutre",
			"start": 16.21,
			"end": 18.11
		},
		{
			"texte": "Règle deux : ouvre la fenêtre maintenant, tant que les vitres électriques marchent encore.",
			"emotion": null,
			"pose": "neutre",
			"start": 18.69,
			"end": 22.62
		},
		{
			"texte": "Sinon, casse la vitre latérale avec un brise-vitre, dans un coin.",
			"emotion": null,
			"pose": "neutre",
			"start": 23,
			"end": 26.01
		},
		{
			"texte": "Jamais le pare-brise : il ne se casse pas.",
			"emotion": null,
			"pose": "neutre",
			"start": 26.29,
			"end": 28.2
		},
		{
			"texte": "Règle trois : sors par la fenêtre.",
			"emotion": null,
			"pose": "neutre",
			"start": 28.76,
			"end": 30.71
		},
		{
			"texte": "S'il y a des enfants, détache-les et fais-les sortir avant toi, le plus grand d'abord.",
			"emotion": null,
			"pose": "neutre",
			"start": 31.08,
			"end": 35.11
		},
		{
			"texte": "Ceinture.",
			"emotion": null,
			"pose": "neutre",
			"start": 35.6,
			"end": 36.17
		},
		{
			"texte": "Fenêtre.",
			"emotion": null,
			"pose": "neutre",
			"start": 36.42,
			"end": 37.045
		},
		{
			"texte": "Dehors.",
			"emotion": null,
			"pose": "neutre",
			"start": 37.045,
			"end": 37.58
		},
		{
			"texte": "Trois mots, une minute.",
			"emotion": null,
			"pose": "neutre",
			"start": 37.95,
			"end": 39.25
		},
		{
			"texte": "Et toi, tu as un brise-vitre dans ta voiture ?",
			"emotion": null,
			"pose": "neutre",
			"start": 39.85,
			"end": 42.05
		}
	],
