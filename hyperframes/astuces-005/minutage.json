	"phrases": [
		{
			"texte": "Ton mot de passe, c'est ton prénom plus ton année de naissance ?",
			"emotion": "direct",
			"pose": "explique",
			"start": 0,
			"end": 2.68
		},
		{
			"texte": "On doit parler.",
			"emotion": null,
			"pose": "explique",
			"start": 3.12,
			"end": 3.73
		},
		{
			"texte": "Voilà comment un pirate pense.",
			"emotion": null,
			"pose": "explique",
			"start": 4.21,
			"end": 5.69
		},
		{
			"texte": "Il ne devine pas à la main : un programme teste énormément de combinaisons à la seconde, en commençant par les mots, les prénoms et les dates.",
			"emotion": null,
			"pose": "explique",
			"start": 6.07,
			"end": 13.12
		},
		{
			"texte": "Ton prénom plus ton année, c'est le premier essai.",
			"emotion": "amusé",
			"pose": "rit",
			"start": 13.55,
			"end": 15.79
		},
		{
			"texte": "Ce qui compte, c'est la longueur, pas les symboles.",
			"emotion": null,
			"pose": "rit",
			"start": 16.29,
			"end": 18.41
		},
		{
			"texte": "Une phrase de quatre ou cinq mots au hasard est bien plus difficile à trouver qu'un mot court avec un point d'exclamation.",
			"emotion": null,
			"pose": "rit",
			"start": 18.88,
			"end": 24.15
		},
		{
			"texte": "Trois gestes : une longue phrase, un mot de passe différent pour chaque site, et un gestionnaire de mots de passe pour tout retenir.",
			"emotion": null,
			"pose": "rit",
			"start": 24.67,
			"end": 30.64
		},
		{
			"texte": "Ton cerveau a mieux à faire.",
			"emotion": "souriant",
			"pose": "content",
			"start": 31.09,
			"end": 32.23
		},
		{
			"texte": "Demain : ta télé éteinte consomme encore.",
			"emotion": null,
			"pose": "content",
			"start": 32.77,
			"end": 34.96
		},
		{
			"texte": "Combien de sites partagent ton mot de passe ?",
			"emotion": null,
			"pose": "content",
			"start": 35.48,
			"end": 37.04
		}
	],
