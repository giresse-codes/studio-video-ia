	"phrases": [
		{
			"texte": "Tu ouvres un site en une seconde.",
			"emotion": "étonné",
			"pose": "surpris",
			"start": 0,
			"end": 1.83
		},
		{
			"texte": "Mais pendant cette seconde, il se passe quatre étapes.",
			"emotion": null,
			"pose": "surpris",
			"start": 2.26,
			"end": 4.51
		},
		{
			"texte": "Imagine que tu commandes une pizza.",
			"emotion": null,
			"pose": "surpris",
			"start": 5.04,
			"end": 6.4
		},
		{
			"texte": "Étape un : tu tapes l'adresse du site.",
			"emotion": null,
			"pose": "surpris",
			"start": 6.93,
			"end": 8.9
		},
		{
			"texte": "Ton navigateur, c'est toi qui commandes.",
			"emotion": null,
			"pose": "surpris",
			"start": 9.25,
			"end": 10.85
		},
		{
			"texte": "Étape deux : il demande à un annuaire, le DNS, où se trouve le site.",
			"emotion": null,
			"pose": "surpris",
			"start": 11.41,
			"end": 15.42
		},
		{
			"texte": "L'annuaire répond avec une adresse en chiffres.",
			"emotion": null,
			"pose": "surpris",
			"start": 15.86,
			"end": 17.6
		},
		{
			"texte": "Étape trois : la commande part vers le serveur, un ordinateur toujours allumé.",
			"emotion": null,
			"pose": "surpris",
			"start": 18.17,
			"end": 22.24
		},
		{
			"texte": "C'est la pizzeria : elle ne dort jamais.",
			"emotion": "amusé",
			"pose": "rit",
			"start": 22.55,
			"end": 24.59
		},
		{
			"texte": "Étape quatre : le serveur renvoie des fichiers.",
			"emotion": null,
			"pose": "rit",
			"start": 25.09,
			"end": 27.47
		},
		{
			"texte": "Le HTML pour la structure, le CSS pour le style, le JavaScript pour les actions.",
			"emotion": null,
			"pose": "rit",
			"start": 27.87,
			"end": 32.77
		},
		{
			"texte": "Ton navigateur assemble tout, et la pizza arrive : ta page.",
			"emotion": null,
			"pose": "rit",
			"start": 33.24,
			"end": 36.47
		},
		{
			"texte": "Ta mission : sur ordinateur, fais un clic droit sur un site, puis « Inspecter ».",
			"emotion": "énergique",
			"pose": "content",
			"start": 36.99,
			"end": 41.11
		},
		{
			"texte": "Sur téléphone, écris view-source: devant l'adresse.",
			"emotion": null,
			"pose": "content",
			"start": 41.53,
			"end": 45.5
		},
		{
			"texte": "Trouve le titre de la page dans le code.",
			"emotion": null,
			"pose": "content",
			"start": 45.88,
			"end": 47.49
		},
		{
			"texte": "Tu l'as trouvé ?",
			"emotion": null,
			"pose": "content",
			"start": 47.92,
			"end": 48.38
		},
		{
			"texte": "Dis-moi quel site en commentaire.",
			"emotion": null,
			"pose": "content",
			"start": 48.76,
			"end": 49.98
		},
		{
			"texte": "Prochain épisode : l'URL.",
			"emotion": null,
			"pose": "content",
			"start": 50.39,
			"end": 52
		}
	],
