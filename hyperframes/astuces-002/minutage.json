	"phrases": [
		{
			"texte": "Un SMS te dit que ton colis est bloqué ?",
			"emotion": "direct",
			"pose": "explique",
			"start": 0,
			"end": 1.79
		},
		{
			"texte": "Respire.",
			"emotion": null,
			"pose": "explique",
			"start": 2.3,
			"end": 2.8
		},
		{
			"texte": "Ne clique pas.",
			"emotion": null,
			"pose": "explique",
			"start": 3.3,
			"end": 4.17
		},
		{
			"texte": "Voilà comment ça marche.",
			"emotion": null,
			"pose": "explique",
			"start": 4.75,
			"end": 5.68
		},
		{
			"texte": "Quelqu'un envoie ce même message à des milliers de numéros, en espérant que tu attendes vraiment un colis.",
			"emotion": null,
			"pose": "explique",
			"start": 6.25,
			"end": 11.41
		},
		{
			"texte": "C'est de la pêche : il lance l'hameçon, et il attend.",
			"emotion": "amusé",
			"pose": "rit",
			"start": 11.82,
			"end": 14.64
		},
		{
			"texte": "Si tu cliques, tu arrives sur un faux site qui ressemble au vrai, et il te demande de payer de petits frais avec ta carte.",
			"emotion": null,
			"pose": "rit",
			"start": 15.19,
			"end": 20.97
		},
		{
			"texte": "Ces frais ne sont qu'un prétexte : c'est ta carte qu'il veut.",
			"emotion": null,
			"pose": "rit",
			"start": 21.43,
			"end": 24.05
		},
		{
			"texte": "Trois signes : un lien bizarre, une urgence, des frais minuscules.",
			"emotion": null,
			"pose": "rit",
			"start": 24.6,
			"end": 28.85
		},
		{
			"texte": "Tu ne cliques pas.",
			"emotion": null,
			"pose": "rit",
			"start": 29.32,
			"end": 30.2
		},
		{
			"texte": "Tu supprimes, et tu signales le message au 33700.",
			"emotion": null,
			"pose": "rit",
			"start": 30.66,
			"end": 34.35
		},
		{
			"texte": "Demain : pourquoi ton wifi rame dans la chambre.",
			"emotion": "souriant",
			"pose": "content",
			"start": 34.86,
			"end": 37.34
		},
		{
			"texte": "Et toi, tu en as déjà reçu un ?",
			"emotion": null,
			"pose": "content",
			"start": 37.85,
			"end": 39.29
		}
	],
